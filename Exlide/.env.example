# Copy to .env and fill in. .env is git-ignored. Never put real keys in this file.

# Speech-to-text: webspeech | mock
STT_PROVIDER=webspeech
# Slide director LLM: ollama | proxy | mock   (proxy = hosted provider via server/)
LLM_PROVIDER=ollama
# Model name for the selected provider (empty = provider default)
LLM_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
PROXY_URL=http://127.0.0.1:8787
# Director tick: ~4000 for fast hosted providers, 6000-8000 for local models
DIRECTOR_INTERVAL_MS=6000
# App debug logger (browser console): true | false
DEBUG=true

# --- Server-side only (read by server/proxy.ts, never sent to the browser) ---
HOSTED_LLM=
HOSTED_LLM_API_KEY=
DEEPGRAM_API_KEY=
